# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL
POSTGRES_DB=fnts
POSTGRES_USER=fnts
POSTGRES_PASSWORD=change-me

# Backend
# Generate with: openssl rand -base64 48   (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=
# Encrypts sensitive free-text at rest (habits, reasons, feedback).
# Generate with: openssl rand -base64 32
# WARNING: losing this key permanently destroys that data — back it up.
DATA_ENCRYPTION_KEY=
# true when serving over HTTPS (production)
SECURE_COOKIES=false

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Feedback briefings (optional — leave blank to just store feedback).
# Gemini key: https://aistudio.google.com/apikey  (free tier is plenty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Where briefing emails are sent
FEEDBACK_NOTIFY_TO=you@example.com
# Gmail account + APP PASSWORD (not your real password):
# Google Account -> Security -> 2-Step Verification -> App passwords
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=

# Auto-file GitHub issues for feedback the AI judges worth building (optional).
# Token: a fine-grained PAT with Issues read+write on the repo below.
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPO=owner/repo
# Public URL of the app, for the one-click "create issue" link in emails.
PUBLIC_BASE_URL=
